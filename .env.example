NODE_ENV=development
PORT=3000

HOST=localhost

LOG_LEVEL=debug

DATABASE_PROVIDER="postgresql"
# Supabase cloud via pooler (transaction mode) — ex:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/animesice_db?schema=public

JWT_ACCESS_SECRET="your-access-secret"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=animesice_db


PGADMIN_EMAIL=admin@animesice.com
PGADMIN_PASSWORD=admin


API_PREFIX=api
SWAGGER_PATH=api/docs

STREAMING_TOKEN_TTL=86400
STREAMING_BASE_URL=https://animesice.io

# Origem pública do backend p/ montar URLs absolutas (ex: https://api.animesice.io).
# Sem isso, o host vem do request — configure quando atrás de proxy/CDN.
PUBLIC_BACKEND_URL=

# Só confie em x-forwarded-* se houver reverse proxy confiável na frente.
TRUST_PROXY=false

# Proxy outbound para TODOS os fetch() (scrape de fontes, re-extração,
# proxy de mídia). Necessário quando o IP do servidor é bloqueado pela CDN
# da fonte (ex: animefire.io devolve 403 p/ IPs de datacenter) — configure
# um proxy residencial p/ o egress sair por IP residencial.
# Formato: http://usuario:senha@host:porta
HTTPS_PROXY=
# Exceções (sempre incluir localhost; separar por vírgula)
NO_PROXY=localhost,127.0.0.1,::1,*.local

# Rate limit global (req/min por IP). Endpoints de auth usam AUTH_THROTTLE_LIMIT.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5

CORS_ORIGIN=http://localhost:3000,http://localhost:4200,https://www.animesice.app,https://animesice.app
CORS_CREDENTIALS=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=videos

# S3 protocol (Supabase Storage) — avatares. Access keys em Storage → S3.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=sa-east-1
SUPABASE_AVATAR_BUCKET=users_icons

# Resend API — email sending (https://resend.com)
RESEND_API_KEY=
# Remetente (domínio deve estar verificado no Resend)
MAIL_FROM_NAME=AnimesIce
MAIL_FROM_EMAIL=noreply@animesice.app
# Turnstile (CAPTCHA) secret — get from https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET=

# Allowlist de hosts p/ proxy de mídia/scrape (fail-closed se vazio).
# CDNs de vídeo + fontes de scrape + referers anti-hotlinking.
EMBED_ALLOWED_HOSTS=googlevideo.com,lightspeedst.net,animefire.io,meusanimes.blog,meusdoramas.club,animesonlinecc.to,youtube.googleapis.com,blogger.com,ytimg.com

# Watchtower — módulo de monitoramento de lançamentos (cron-driven).
# enable=true ativa os 3 crons: tick (1min), scheduleReleases (15min), dailyTasks (3AM).
WATCHTOWER_ENABLED=true
WT_TICK_BATCH=5
WT_REPAIR_ENABLED=true
WT_REPAIR_DAILY_CAP=20
WT_SEASON_DISCOVERY_ENABLED=true
