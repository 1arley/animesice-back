NODE_ENV=development
PORT=3000

HOST=localhost

LOG_LEVEL=debug

DATABASE_PROVIDER="postgresql"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/animesice_db?schema=public

JWT_ACCESS_SECRET="your-access-secret"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=animesice_db


PGADMIN_EMAIL=admin@animesice.com
PGADMIN_PASSWORD=admin


API_PREFIX=api
SWAGGER_PATH=api/docs

STREAMING_TOKEN_TTL=86400
STREAMING_BASE_URL=https://animesice.io

# Origem pública do backend p/ montar URLs absolutas (ex: https://api.animesice.io).
# Sem isso, o host vem do request — configure quando atrás de proxy/CDN.
PUBLIC_BACKEND_URL=

# Só confie em x-forwarded-* se houver reverse proxy confiável na frente.
TRUST_PROXY=false

# Rate limit global (req/min por IP). Endpoints de auth usam AUTH_THROTTLE_LIMIT.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5

CORS_ORIGIN=http://localhost:3000,http://localhost:4200
CORS_CREDENTIALS=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=videos

# Cloudflare Email Worker — URL do Worker que envia emails
MAIL_WORKER_URL=https://animesice-mail.workers.dev/send
# Token compartilhado entre backend e Worker (Bearer auth — second layer)
MAIL_WORKER_TOKEN=
# Cloudflare Access service token (when Worker is behind CF Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Nome remetente (email sempre noreply@animesice.app)
MAIL_FROM_NAME=AnimesIce